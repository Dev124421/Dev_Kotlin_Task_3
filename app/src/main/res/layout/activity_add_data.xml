<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".add_data"
    android:background="@color/white"
    android:padding="35dp">

    <TextView
        android:id="@+id/Head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="36dp"
        android:text="Create Data"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/Subhead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:text="Enter the data"
        app:layout_constraintTop_toTopOf="@id/Head"
        android:layout_marginTop="45dp"
        android:textSize="18dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/titlehead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Title :"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="20dp"
        app:layout_constraintTop_toTopOf="@id/Subhead"
        android:layout_marginTop="80dp"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/titlehead"
        android:layout_marginTop="35dp"
        android:inputType="text"
        android:hint="enter the title name"
        android:background="@drawable/input_box"
        android:textColor="@color/black"
        android:singleLine="true"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="center"/>

    <TextView
        android:id="@+id/authorhead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Author :"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="20dp"
        app:layout_constraintTop_toTopOf="@id/title"
        android:layout_marginTop="80dp"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/author"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/authorhead"
        android:layout_marginTop="35dp"
        android:background="@drawable/input_box"
        android:hint="Enter the author name"
        android:textColor="@color/black"
        android:singleLine="true"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="center"/>

    <TextView
        android:id="@+id/contenthead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Content :"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="20dp"
        app:layout_constraintTop_toTopOf="@id/author"
        android:layout_marginTop="80dp"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/contenthead"
        android:layout_marginTop="35dp"
        android:background="@drawable/input_box"
        android:hint="Enter the content"
        android:textColor="@color/black"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="center"/>

    <Button
        android:id="@+id/piblishbtn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/content"
        android:layout_marginTop="80dp"
        android:text="Publish"
        android:textColor="@color/white"
        android:textSize="24dp"
        android:clickable="true"/>

</androidx.constraintlayout.widget.ConstraintLayout>