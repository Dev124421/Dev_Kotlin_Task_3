<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/primary_background"
    tools:context=".home">

    <!-- Top Bar: Hamburger ≡, Inkora, Notification, Refresh -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textColor="@color/primary_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvBrandTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Inkora"
            android:textColor="@color/primary_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:text="🔔"
            android:textSize="18sp" />

        <Button
            android:id="@+id/refresh"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="Refresh"
            android:textAllCaps="false"
            android:textColor="@color/primary_red"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tabs Container: "For You" & "Following" -->
    <LinearLayout
        android:id="@+id/tabsLayout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <!-- "For You" Tab -->
        <LinearLayout
            android:id="@+id/tabForYou"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingEnd="18dp">

            <TextView
                android:id="@+id/tvTabForYou"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="For You"
                android:textColor="@color/primary_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/indicatorForYou"
                android:layout_width="22dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_primary_button" />
        </LinearLayout>

        <!-- "Following" Tab -->
        <LinearLayout
            android:id="@+id/tabFollowing"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/tvTabFollowing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Following"
                android:textColor="@color/secondary_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/indicatorFollowing"
                android:layout_width="22dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>

    <!-- Category Filter Bar (All, Tech, Design, Life, Art) -->
    <HorizontalScrollView
        android:id="@+id/categoryFilterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tabsLayout">

        <LinearLayout
            android:id="@+id/layoutCategoryChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/chipHomeAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_filter_selected"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="All"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipHomeTech"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_filter_unselected"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Tech"
                android:textColor="@color/secondary_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipHomeDesign"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_filter_unselected"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Design"
                android:textColor="@color/secondary_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipHomeLife"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_filter_unselected"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Life"
                android:textColor="@color/secondary_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipHomeArt"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_filter_unselected"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Art"
                android:textColor="@color/secondary_text"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/pbFeedLoading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        android:indeterminateTint="@color/primary_red"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/categoryFilterScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty Feed State -->
    <TextView
        android:id="@+id/tvEmptyFeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No posts found in this feed.\nCreate the first story!"
        android:textAlignment="center"
        android:textColor="@color/secondary_text"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/categoryFilterScroll"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Blog Feed RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFeed"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/categoryFilterScroll"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav" />

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/secondary_background"
        app:elevation="12dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
